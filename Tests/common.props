<Project>
    <Import Project="..\project.props" />

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Nerosoft.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
		<IsPackable>false</IsPackable>
		<!--
		  xunit.v3 通过 Microsoft.Testing.Platform 运行，要求测试项目为可执行程序。
		  .NET 10 起 MTP 项目不再支持 VSTest 目标，故不再引用 Microsoft.NET.Test.Sdk / xunit.runner.visualstudio。
		-->
		<OutputType>Exe</OutputType>
    </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" />
		<PackageReference Include="Moq" />
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="Xunit.DependencyInjection" />
        <PackageReference Include="Xunit.DependencyInjection.Logging" />
        <PackageReference Include="coverlet.collector">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
	</ItemGroup>
	
    <ItemGroup>
        <Using Include="System" />
        <Using Include="System.Collections" />
		<Using Include="System.Collections.Generic" />
		<Using Include="System.Linq" />
		<Using Include="System.Text" />
        <Using Include="System.Threading" />
        <Using Include="System.Threading.Tasks" />
		<Using Include="Xunit" />
    </ItemGroup>
</Project>
