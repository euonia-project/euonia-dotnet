<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\common.props" />
    <Import Project="..\resource.props" />

    <PropertyGroup>
        <Description>Euonia 总线 HTTP 远程传输：客户端通过 HTTP POST 执行 CallAsync，服务端端点执行处理器并返回结果，与 gRPC 传输共用 RemoteReply 线路协议。 / HTTP remote transport for Euonia Bus: client-side CallAsync over HTTP POST plus a server endpoint that executes handlers and returns results, sharing the RemoteReply wire protocol with the gRPC transport.</Description>
        <PackageTags>euonia, message-bus, http, remote, transport, rpc</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Euonia.Bus\Euonia.Bus.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Properties\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Properties\Resources.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

</Project>
