<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\common.props" />

	<PropertyGroup>
		<Description>Permission integration for Euonia.Osba: wires Osba's permission contracts (requirement provider, operation checker, row-scope authorizer) to the Euonia.Security policy engine. Reference this package to get engine-backed permission; hosts that prefer their own implementation can register the Osba contracts directly instead and never reference the engine.</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Euonia.Osba\Euonia.Osba.csproj" />
		<ProjectReference Include="..\Euonia.Security\Euonia.Security.csproj" />
	</ItemGroup>

</Project>
