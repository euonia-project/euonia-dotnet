<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\common.props" />
    <Import Project="..\resource.props" />

	<PropertyGroup>
		<Description>Authorization primitives: operation permission requirements and data-scope (row-level) policy engine for Euonia. Independent of any object model, user model and application framework; host applications declare the operation rules (callback, configuration or a custom source) and supply the user accessor and grant resolver.</Description>
	</PropertyGroup>

	<PropertyGroup Condition="$(TargetFramework.Contains('netstandard'))">
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- DI.Abstractions：AddPermission 这一注册入口所需。 -->
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Euonia.Core\Euonia.Core.csproj" />
	</ItemGroup>

    <ItemGroup>
        <Compile Update="Properties\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Properties\Resources.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

</Project>
