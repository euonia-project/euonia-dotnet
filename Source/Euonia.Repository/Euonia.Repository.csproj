<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\common.props" />
    <Import Project="..\resource.props" />

    <PropertyGroup>
        <Description>Euonia 持久化无关仓储抽象：IRepository&lt;TEntity&gt;、仓储上下文、审计/软删除/并发实体契约及 Repository&lt;TContext,TEntity,TKey&gt; 基类。 / Persistence-agnostic repository abstractions for Euonia: IRepository&lt;TEntity&gt;, repository context, auditing/soft-delete/concurrency entity contracts and the Repository&lt;TContext,TEntity,TKey&gt; base.</Description>
        <PackageTags>euonia, repository, persistence, data-access, unit-of-work, specification</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Options" />
    </ItemGroup>

    <ItemGroup>
<!--        <ProjectReference Include="..\Euonia.Domain\Euonia.Domain.csproj" />-->
        <ProjectReference Include="..\Euonia.Linq\Euonia.Linq.csproj" />
        <ProjectReference Include="..\Euonia.Modularity\Euonia.Modularity.csproj" />
        <ProjectReference Include="..\Euonia.Uow\Euonia.Uow.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Properties\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Properties\Resources.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

</Project>
