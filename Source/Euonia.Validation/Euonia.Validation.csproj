<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\common.props" />
    <Import Project="..\resource.props" />

    <PropertyGroup>
        <Description>Euonia 校验框架：集成 FluentValidation，提供泛型、范围和正则校验器、带可观察错误的自校验对象，以及携带校验结果的异常。 / Validation framework for Euonia: FluentValidation integration, generic, range and regular-expression validators, a self-validating object with observable errors and a validation exception carrying results.</Description>
        <PackageTags>euonia, validation, fluentvalidation, validator, rules</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Euonia.Modularity\Euonia.Modularity.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Properties\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Properties\Resources.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

</Project>
