<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\common.props" />
    <Import Project="..\resource.props" />

    <PropertyGroup>
        <Description>Euonia 总线健康检查：报告已配置的传输器以及 Outbox、Inbox 和死信积压，可直接接入 ASP.NET Core 健康检查端点。 / Health checks for Euonia Bus: reports configured transporters and outbox, inbox and dead-letter backlog, ready to plug into ASP.NET Core health endpoints.</Description>
        <PackageTags>euonia, message-bus, healthchecks, health-check, aspnetcore, monitoring</PackageTags>
    </PropertyGroup>

    <PropertyGroup>
        <RootNamespace>Nerosoft.Euonia.Bus.HealthChecks</RootNamespace>
    </PropertyGroup>

    <!--
      健康检查抽象（IHealthCheck / HealthCheckRegistration / IHealthChecksBuilder）由
      Microsoft.AspNetCore.App 共享框架提供，与 Euonia.Bus.Http 的做法一致，无需额外包引用。
    -->
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Euonia.Bus\Euonia.Bus.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Properties\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Properties\Resources.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

</Project>
